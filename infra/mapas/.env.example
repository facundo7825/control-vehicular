# Copiar a .env (ignorado por git) y completar. docker compose lo lee solo.

# Obligatoria: clave interna del PostgreSQL de Nominatim (no se publica fuera del contenedor). Elegir una larga.
NOMINATIM_CLAVE_DB=

# Región de los datos (catamarca): la misma que se preparó con REGION=... ./preparar-datos.sh.
# argentina = todo el país (viajes a otras provincias). Al cambiarla, ver "Cambiar de región" en docs/PRODUCCION-MAPAS.md.
# MAPAS_REGION=catamarca

# Opcionales (valores por defecto entre paréntesis):
# MAPAS_ESCUCHA=127.0.0.1      # IP donde escuchan los puertos; una IP de la red interna si el backend está en otra máquina
# OSRM_PUERTO=5001
# NOMINATIM_PUERTO=8088
# TESELAS_PUERTO=8089
# NOMINATIM_WORKERS=2
# OSRM_MEMORIA=4g
# NOMINATIM_MEMORIA=5g
# TESELAS_MEMORIA=1g
