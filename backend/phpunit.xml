<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="APP_LOCALE" value="es"/>
        <env name="APP_FALLBACK_LOCALE" value="es"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="LUGARES_DRIVER" value="falso"/>
        <env name="RUTAS_DRIVER" value="falso"/>
        <!-- Mapas: valores fijos para que un .env local (p. ej. apuntando a servidores propios) no cambie los tests. -->
        <env name="MAPAS_DRIVER" value="falso"/>
        <env name="MAPAS_TESELAS_URL" value="https://tile.openstreetmap.org/{z}/{x}/{y}.png"/>
        <env name="MAPAS_TESELAS_ATRIBUCION" value="© OpenStreetMap contributors"/>
        <env name="MAPAS_TESELAS_ATRIBUCION_URL" value="https://www.openstreetmap.org/copyright"/>
        <env name="MAPAS_TESELAS_TMS" value="false"/>
        <env name="MAPAS_TESELAS_MAX_ZOOM" value="19"/>
        <env name="LUGARES_NOMINATIM_URL" value="https://nominatim.openstreetmap.org"/>
        <env name="LUGARES_GEOREF_URL" value="https://apis.datos.gob.ar/georef/api"/>
        <env name="LUGARES_PROVINCIA" value=""/>
        <env name="LUGARES_LIMITE_POR_MINUTO" value="30"/>
        <env name="RUTAS_OSRM_URL" value="https://router.project-osrm.org"/>
        <env name="ASISTENCIA_CLAVE" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
