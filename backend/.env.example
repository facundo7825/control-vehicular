APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

NOTIFICACIONES_DRIVER=registro
# Zona horaria de los usuarios (textos de push y agenda). La app y la base quedan en UTC.
VEHICULOS_ZONA_HORARIA=America/Argentina/Buenos_Aires
# Ruta al JSON de la cuenta de servicio del proyecto Firebase de la app del PJ
FIREBASE_CREDENTIALS=

# Reverb (tiempo real). Para usarlo: BROADCAST_CONNECTION=reverb y correr `php artisan reverb:start`.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Google Maps: la clave del servidor (Distance Matrix, Directions) y la del mapa del panel (Maps JavaScript API,
# restringida por HTTP referrer). Sin clave JS el panel usa la del servidor; sin ninguna, no muestra el mapa.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_JS_API_KEY=

# Busqueda de direcciones para el destino: nominatim (OpenStreetMap; el publico solo para desarrollo/demos, 1 pedido
# por segundo y sin autocompletar; LUGARES_NOMINATIM_URL apunta a uno propio, sin esos limites), georef (API Georef
# del Estado, acotada a LUGARES_PROVINCIA), google (Places, usa GOOGLE_MAPS_API_KEY) o falso. Admite una lista que
# se consulta en orden y se une, por ejemplo "nominatim,georef". LUGARES_USER_AGENT debe identificar la aplicacion.
# LUGARES_AUTOCOMPLETAR (true/false) fuerza si la app busca mientras se escribe; sin valor lo decide el driver.
LUGARES_DRIVER=nominatim
# LUGARES_USER_AGENT="VehiculosOficiales/1.0 (+https://ejemplo.org/contacto)"
# LUGARES_NOMINATIM_URL=https://nominatim.openstreetmap.org
# LUGARES_GEOREF_URL=https://apis.datos.gob.ar/georef/api
# LUGARES_PROVINCIA=Catamarca
# LUGARES_AUTOCOMPLETAR=

# Recorrido con indicaciones: osrm (servidor publico de OSRM, solo desarrollo/demos, 1 pedido por segundo;
# RUTAS_OSRM_URL apunta a un OSRM propio, sin ese limite), google (Directions, usa GOOGLE_MAPS_API_KEY) o falso.
# RUTAS_USER_AGENT (si falta, LUGARES_USER_AGENT) debe identificar la aplicacion.
RUTAS_DRIVER=osrm
# RUTAS_OSRM_URL=https://router.project-osrm.org
# RUTAS_USER_AGENT="VehiculosOficiales/1.0 (+https://ejemplo.org/contacto)"

# Tiempos de viaje (chofer mas cercano, llegada estimada, duracion de reservas): falso (linea recta a 30 km/h),
# osrm (el mismo OSRM de RUTAS_OSRM_URL; en produccion, uno propio) o google (Distance Matrix, usa GOOGLE_MAPS_API_KEY).
MAPAS_DRIVER=falso

# Mapa de fondo de la app (sin clave de Google) y del panel: llega a la app por /api/configuracion, sin recompilar.
# Por defecto el OSM publico (solo desarrollo/demos). TMS=true para servidores con la Y invertida (p. ej. el IGN).
# ATRIBUCION_URL: a donde lleva el texto de creditos (vacia: sin enlace).
# MAPAS_TESELAS_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAPAS_TESELAS_ATRIBUCION="OpenStreetMap contributors"
# MAPAS_TESELAS_ATRIBUCION_URL=https://www.openstreetmap.org/copyright
# MAPAS_TESELAS_TMS=false
# MAPAS_TESELAS_MAX_ZOOM=19

# --- Produccion sin Google (servidor de mapas propio de infra/mapas; ver docs/PRODUCCION-MAPAS.md) ---
# LUGARES_DRIVER=nominatim,georef
# LUGARES_NOMINATIM_URL=http://127.0.0.1:8088
# LUGARES_GEOREF_URL=https://apis.datos.gob.ar/georef/api
# LUGARES_PROVINCIA=Catamarca
# RUTAS_DRIVER=osrm
# RUTAS_OSRM_URL=http://127.0.0.1:5001
# MAPAS_DRIVER=osrm
# MAPAS_TESELAS_URL=https://mapas.ejemplo.gob.ar/styles/basico/{z}/{x}/{y}.png
# MAPAS_TESELAS_ATRIBUCION="OpenMapTiles, OpenStreetMap contributors"
# MAPAS_TESELAS_ATRIBUCION_URL=https://www.openstreetmap.org/copyright
# MAPAS_TESELAS_TMS=false
# MAPAS_TESELAS_MAX_ZOOM=18

# Minutos de vigencia de los tokens de sesion de la app (1440 = 24 h, alcanza para un turno de chofer).
SANCTUM_EXPIRATION=1440
